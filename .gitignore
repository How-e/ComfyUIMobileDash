# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
*.log
/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local screenshots and review captures. Intentional app assets belong in /public.
/captures/
/imgs/
/screenshots/

# Local configuration and secrets. Only the documented template is public.
.env*
!.env.example

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/
