# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Windows batch files require CRLF line endings
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.mp4 binary
*.webm binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
