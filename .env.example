# ComfyUI Connection (Optional, default: http://127.0.0.1:8188)
# Sets the upstream ComfyUI server address for the Vite proxy.
COMFYUI_URL=http://127.0.0.1:8188

# Workflow Directory for Integration Tests (Optional, default: auto-detected)
# Point this to a local ComfyUI workflow folder if running workflow conversion tests.
COMFYUI_WORKFLOW_DIR=

# LM Studio Server URL (Optional, default: http://127.0.0.1:1234)
# Address used by Prompt Studio and the local AI controller.
LMSTUDIO_URL=http://127.0.0.1:1234

# LM Studio Presets Directory (Optional, default: auto-detected in user profile)
# Windows default: %USERPROFILE%\.lmstudio\config-presets
# Linux/macOS default: ~/.lmstudio/config-presets
LMSTUDIO_PRESET_DIR=

# Dashboard Server Binding (Optional, defaults: HOST=0.0.0.0, PORT=5173)
# Set HOST=127.0.0.1 to restrict access to local machine only instead of LAN.
HOST=0.0.0.0
PORT=5173

